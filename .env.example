# ============================================================
# 模型（OpenAI 兼容接口）。不填 LLM_API_KEY 时自动降级为本地 mock，
# 界面仍可照常演示，但回答是预置文本，不能用于验收。
# ============================================================
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-chat-model
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90

# ============================================================
# 向量模型。EMBEDDING_PROVIDER=local 可完全离线运行（精度略低）。
# 走 API 时注意供应商的单批条数上限，超了会自动二分重试。
# ============================================================
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BATCH_SIZE=10

# ============================================================
# 鉴权
# ============================================================
JWT_EXPIRE_HOURS=8
# 生产环境必须显式设置，否则每次重启都会生成新密钥，导致所有人掉线
# JWT_SECRET=replace-with-a-long-random-string

# ============================================================
# 存储位置。默认在 data/runtime/ 下，已被 .gitignore 排除。
# ============================================================
# LOGISTICS_DB_PATH=/absolute/path/to/chat.db
# RAG_INDEX_DIR=/absolute/path/to/index

# ============================================================
# 限流与配额（默认开启）。单账号刷接口会打满模型额度，别关。
# ============================================================
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW=60            # 滑动窗口长度（秒）
RATE_LIMIT_MAX_REQUESTS=10      # 窗口内每人最大提问次数
LLM_DAILY_QUOTA=200             # 每人每日模型调用上限
AGENT_MAX_CONCURRENT=4          # 全局同时执行的 Agent 循环数
AGENT_ACQUIRE_TIMEOUT=15        # 并发排队等待上限（秒）

# ============================================================
# 日志脱敏（默认开启）。关闭后工具参数会原样入库，仅限本地调试。
# ============================================================
LOG_MASKING=1

# ============================================================
# 运行日志保留天数。只清理 agent_runs / agent_steps / tool_calls，
# 草稿、校验凭证等业务单据不受影响；设为 0 关闭自动清理。
# ============================================================
LOG_RETENTION_DAYS=90

# ============================================================
# 登录 Cookie 的 Secure 标记。
# 留空 = 按请求协议自动判断（HTTPS 开启、本地 http 关闭）；
# 反向代理未传 X-Forwarded-Proto 时可强制设为 1。
# ============================================================
# COOKIE_SECURE=1

# ============================================================
# 演示脚本账号。仅 scripts/check_confirm_http.py 使用，
# 生产部署不要设置这两项。
# ============================================================
DEMO_EMPLOYEE_USER=employee
DEMO_EMPLOYEE_PASSWORD=emp123

# ============================================================
# 自检脚本访问的服务地址。仅 scripts/check_confirm_api.py 使用，
# 服务换了端口或跑在容器里时改这里，不需要动脚本。
# ============================================================
# CHECK_BASE_URL=http://127.0.0.1:8000
