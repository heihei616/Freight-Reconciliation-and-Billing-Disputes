# ============================================================
# 运行环境。development 只做告警；production 会在启动时强制检查
# 模型密钥、JWT_SECRET、Secure Cookie、演示口令，任一不满足直接拒绝启动。
# ============================================================
APP_ENV=development

# ============================================================
# 服务监听地址。默认只监听回环，适合本机演示；
# 容器部署时用 SERVER_HOST=0.0.0.0（Dockerfile 已内置）。
# 放在反向代理后面时，FORWARDED_ALLOW_IPS 填代理的地址，才会信任
# X-Forwarded-Proto / X-Forwarded-For。
# ============================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1

# ============================================================
# 允许的跨站来源（CSRF 校验）。默认只认 Host 自身；
# 前端与接口分开部署时，把前端域名加进来，逗号分隔。
# ============================================================
# ALLOWED_ORIGINS=https://settle.example.com

# ============================================================
# 模型（OpenAI 兼容接口）。不填 LLM_API_KEY 时自动降级为本地 mock，
# 界面仍可照常演示，但回答是预置文本，不能用于验收。
# ============================================================
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-chat-model
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90

# 生产环境默认要求模型地址是 https。内网自建模型只有 http 时，
# 显式设这个开关表示「我确认这是内网链路」，否则启动会被拒绝。
# ALLOW_INSECURE_LLM=1

# ============================================================
# 向量模型。EMBEDDING_PROVIDER=local 可完全离线运行（精度略低）。
# 走 API 时注意供应商的单批条数上限，超了会自动二分重试。
# ============================================================
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BATCH_SIZE=10

# ============================================================
# 鉴权
# ============================================================
JWT_EXPIRE_HOURS=8
# 生产环境必须显式设置，否则每次重启都会生成新密钥，导致所有人掉线
# JWT_SECRET=replace-with-a-long-random-string

# 首次启动的账号来源。
# 开发环境默认播种 admin/admin123、employee/emp123 两个演示账号；
# 生产环境默认**不播种**（口令随代码发版，等于后台默认开放）。
# 生产首次部署二选一：
#   1) 设 ADMIN_INITIAL_PASSWORD（≥12 位），启动后用它登录 admin，立即改密并删掉该变量；
#   2) 先以 development 起一次建库，用 scripts/set_password.py 设好口令，再切 production。
# SEED_DEMO_USERS=0
# ADMIN_INITIAL_PASSWORD=

# ============================================================
# 存储位置。默认在 data/runtime/ 下，已被 .gitignore 排除。
# ============================================================
# LOGISTICS_DB_PATH=/absolute/path/to/chat.db
# RAG_INDEX_DIR=/absolute/path/to/index

# ============================================================
# 限流与配额（默认开启）。单账号刷接口会打满模型额度，别关。
# ============================================================
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW=60            # 滑动窗口长度（秒）
RATE_LIMIT_MAX_REQUESTS=10      # 窗口内每人最大提问次数
LLM_DAILY_QUOTA=200             # 每人每日模型调用上限
AGENT_MAX_CONCURRENT=4          # 全局同时执行的 Agent 循环数
AGENT_ACQUIRE_TIMEOUT=15        # 并发排队等待上限（秒）

# ============================================================
# 登录防爆破（默认开启）。没有这一层，PBKDF2 反而会变成 CPU 放大器：
# 攻击者并发大量登录请求，每个都让服务器算 20 万次哈希。
# 两个维度同时生效：同一账号失败 5 次锁 15 分钟；同一 IP 失败 20 次锁 5 分钟。
# 反向代理后要确保 uvicorn 的 FORWARDED_ALLOW_IPS 配置正确，否则所有请求
# 会被记成同一个代理 IP，一个人手误就能把整个办公室锁住。
# ============================================================
LOGIN_GUARD_ENABLED=1
LOGIN_MAX_FAILURES=5            # 同一账号窗口内允许的失败次数
LOGIN_WINDOW_SECONDS=900        # 账号维度窗口（秒）
LOGIN_IP_MAX_FAILURES=20        # 同一 IP 窗口内允许的失败次数
LOGIN_IP_WINDOW_SECONDS=300     # IP 维度窗口（秒）

# ============================================================
# 日志脱敏（默认开启）。关闭后工具参数会原样入库，仅限本地调试。
# ============================================================
LOG_MASKING=1

# ============================================================
# 运行日志保留天数。只清理 agent_runs / agent_steps / tool_calls，
# 草稿、校验凭证等业务单据不受影响；设为 0 关闭自动清理。
# ============================================================
LOG_RETENTION_DAYS=90

# ============================================================
# 登录 Cookie 的 Secure 标记。
# 留空 = 按请求协议自动判断（HTTPS 开启、本地 http 关闭）；
# 反向代理未传 X-Forwarded-Proto 时可强制设为 1。
# ============================================================
# COOKIE_SECURE=1

# ============================================================
# 演示脚本账号。仅 scripts/check_confirm_http.py 使用，
# 生产部署不要设置这两项。
# ============================================================
DEMO_EMPLOYEE_USER=employee
DEMO_EMPLOYEE_PASSWORD=emp123

# ============================================================
# 自检脚本访问的服务地址。仅 scripts/check_confirm_api.py 使用，
# 服务换了端口或跑在容器里时改这里，不需要动脚本。
# ============================================================
# CHECK_BASE_URL=http://127.0.0.1:8000

# ============================================================
# Prometheus 指标。默认开启，只允许本机访问；
# 跨机抓取时设置 METRICS_TOKEN，并在抓取端加 Authorization: Bearer。
# 不需要指标可设 METRICS_ENABLED=0。
# 注意：同机反向代理下所有请求都来自 127.0.0.1，「仅本机」会失效，
# 所以 APP_ENV=production 时必须设 METRICS_TOKEN 或显式关闭，
# 否则启动校验会直接拒绝。
# ============================================================
METRICS_ENABLED=1
# METRICS_TOKEN=replace-with-a-long-random-string
