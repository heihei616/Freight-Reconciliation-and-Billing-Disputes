# 跨编辑器的统一约定。安装 EditorConfig 插件后自动生效。
# 目的：避免不同人提交时因为缩进/换行差异产生大段无意义 diff。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Markdown 的行尾两个空格代表换行，不能全局清理
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
charset = ascii

[Makefile]
indent_style = tab
